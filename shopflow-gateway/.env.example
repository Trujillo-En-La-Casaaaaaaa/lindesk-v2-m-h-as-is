# Public host port of the gateway. The composed stack publishes 3001 on the host;
# inside the compose network the container listens on the same port.
PORT=3001

# Base URL of the shopflow-orders service (owner of POST /orders, GET /orders/:id, POST /orders/:id/ship).
ORDERS_URL=http://orders:3002

# Base URL of the shopflow-inventory service (owner of GET /products).
INVENTORY_URL=http://inventory:3003

# Bounded upstream request timeout in milliseconds. Applied per upstream attempt.
UPSTREAM_TIMEOUT_MS=5000
